---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Products from '../components/Products.astro';
import Principles from '../components/Principles.astro';
import NameStory from '../components/NameStory.astro';
import OpenNumbers from '../components/OpenNumbers.astro';
import BuildLog from '../components/BuildLog.astro';
import Founder from '../components/Founder.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Products />
    <Principles />
    <NameStory />
    <OpenNumbers />
    <BuildLog />
    <Founder />
    <Newsletter />
  </main>
  <Footer />
</Base>
