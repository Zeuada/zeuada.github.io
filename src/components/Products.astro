---
import EmailForm from './EmailForm.astro';
import { site } from '../data/site';

const unloop = site.products[0];
---

<section id="products" class="section">
  <div class="container section-pad">
    <div class="intro">
      <h2 class="h2">Tools that each do one job, exceptionally well.</h2>
      <p class="lead">Different problems, one standard. Every product ships under the {site.name} mark.</p>
    </div>

    <article id={unloop.id} class="panel">
      <div class="panel-copy">
        <div class="meta">
          <span class="tag tag-volt">{unloop.status}</span>
          <span class="meta-text">{unloop.platform}</span>
          <span class="meta-text mono">{unloop.version}</span>
        </div>
        <h3 class="name">{unloop.name}</h3>
        <p class="headline">{unloop.headline}</p>
        <p class="lead">{unloop.description}</p>
        <p class="note">{unloop.note}</p>
        <EmailForm
          id="unloop-email"
          label="Email for Unloop early access"
          button="Get early access"
          action={site.forms.earlyAccessAction}
        />
      </div>

      <div class="panel-visual" aria-hidden="true">
        <div class="phone">
          <p class="phone-label">Reels this session</p>
          <p class="phone-count mono">37</p>
          <div class="meter"><span></span></div>
          <p class="phone-time mono">14 min of scrolling</p>
          <div class="prompt">
            <p>Still worth it? Take a second before the next one.</p>
            <div class="prompt-actions">
              <span class="prompt-btn solid">Close Instagram</span>
              <span class="prompt-btn">Keep going</span>
            </div>
          </div>
        </div>
      </div>
    </article>

    <div class="next">
      <div>
        <p class="next-title">The next tool is in the workshop</p>
        <p class="next-body">It gets announced on the build log before anywhere else.</p>
      </div>
      <span class="tag">Building</span>
    </div>
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 48px;
  }
  .intro .h2 {
    max-width: 640px;
  }
  .intro .lead {
    max-width: 340px;
  }
  .panel {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    background: var(--graphite);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .panel-copy {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(28px, 4vw, 56px);
  }
  .panel-copy .lead,
  .headline,
  .note {
    max-width: 460px;
  }
  .panel-copy .lead {
    line-height: 1.65;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .meta-text {
    font-size: 14px;
    color: var(--dim);
  }
  .meta-text.mono {
    font-size: 13px;
  }
  .name {
    font-size: clamp(44px, 5vw, 68px);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .headline {
    font-size: 22px;
    line-height: 1.4;
  }
  .note {
    font-size: 15px;
    color: var(--mist);
  }
  .panel-copy :global(.form) {
    margin-top: 8px;
  }
  .panel-visual {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(28px, 4vw, 56px);
    background: var(--panel-deep);
    border-left: 1px solid var(--line-soft);
  }
  .phone {
    box-sizing: border-box;
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 24px;
    background: var(--obsidian);
    border: 1px solid #2a3244;
    border-radius: 22px;
  }
  .phone-label {
    font-size: 14px;
    color: var(--dim);
  }
  .phone-count {
    font-size: 76px;
    line-height: 1;
    font-weight: 500;
    color: var(--text-bright);
  }
  .meter {
    height: 4px;
    overflow: hidden;
    background: #1c2230;
    border-radius: 2px;
  }
  .meter span {
    display: block;
    width: 68%;
    height: 100%;
    background: var(--volt);
  }
  .phone-time {
    font-size: 15px;
    color: var(--mist);
  }
  .prompt {
    padding-top: 18px;
    border-top: 1px solid #1c2230;
  }
  .prompt p {
    margin-bottom: 14px;
    font-size: 17px;
    line-height: 1.45;
  }
  .prompt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .prompt-btn {
    box-sizing: border-box;
    flex: 1 1 120px;
    padding: 12px;
    text-align: center;
    font-size: 15px;
    color: var(--mist);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }
  .prompt-btn.solid {
    background: var(--text);
    color: var(--obsidian);
    border-color: var(--text);
    font-weight: 500;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 16px;
    padding: 26px clamp(24px, 4vw, 40px);
    border: 1px dashed #2a3244;
    border-radius: 14px;
  }
  .next-title {
    margin-bottom: 6px;
    font-size: 20px;
    font-weight: 500;
  }
  .next-body {
    font-size: 16px;
    color: var(--mist);
  }
  @media (max-width: 860px) {
    .panel-visual {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
    }
  }
</style>
