---
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Zeuada home">
      <Logo height={30} />
      <span class="wordmark">zeuada</span>
    </a>
    <nav aria-label="Main" class="nav">
      <a class="nav-link" href="/#products">Products</a>
      <a class="nav-link" href="/#build">How we build</a>
      <a class="nav-link" href="/#log">Build log</a>
      <a class="nav-link" href="/#founder">About</a>
      <a class="btn btn-light nav-cta" href="/#unloop">Get early access</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 18px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }
  .wordmark {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
  }
  .nav-link {
    color: var(--mist);
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    .nav-link {
      display: none;
    }
  }
</style>
